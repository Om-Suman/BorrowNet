# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/borrownet?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=14

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Seed
ADMIN_EMAIL=admin@borrownet.com
ADMIN_PASSWORD=AdminPass123!
